# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
ENV/
env/
*.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VS Code settings
.vscode/

# MacOS files
.DS_Store

# Windows files
Thumbs.db
desktop.ini

# Logs and temp files
*.log
*.tmp

# Data (if you don't want to track raw/processed CSVs in Git)
data/raw/
data/processed/

# Results (plots, summary tables)
results/plots/
results/summary_tables/

# Python package directories
.eggs/
*.egg-info/
dist/
build/

# Reports (optional if large PDFs)
reports/project_report.pdf